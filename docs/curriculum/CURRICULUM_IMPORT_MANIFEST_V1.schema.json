{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konkourix.local/schemas/curriculum-import-manifest-v1.json",
  "title": "Konkourix Curriculum Import Manifest v1",
  "description": "Reviewed transport manifest for a draft-only canonical curriculum import. It does not authorize review or publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestSchemaVersion",
    "manifestChecksum",
    "sourceArtifactName",
    "sourceArtifactSha256",
    "transcriptionId",
    "transcriptionSha256",
    "payloadChecksum",
    "idempotencyKey",
    "expectedRevision",
    "records"
  ],
  "properties": {
    "manifestSchemaVersion": { "const": "1.0.0" },
    "manifestChecksum": { "$ref": "#/$defs/sha256" },
    "sourceArtifactName": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sourceArtifactSha256": { "$ref": "#/$defs/sha256" },
    "transcriptionId": { "type": "string", "minLength": 1, "maxLength": 500 },
    "transcriptionSha256": { "$ref": "#/$defs/sha256" },
    "payloadChecksum": { "$ref": "#/$defs/sha256" },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200 },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/sourceRecord" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceRecordKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,499}$"
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRecordKey",
        "rawText",
        "displayLabel",
        "sourceLocator",
        "sourceOrder",
        "checksum"
      ],
      "properties": {
        "sourceRecordKey": { "$ref": "#/$defs/sourceRecordKey" },
        "rawText": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "displayLabel": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceLocator": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sourceOrder": { "type": "integer", "minimum": 0 },
        "checksum": { "$ref": "#/$defs/sha256" },
        "proposedNodeTypeCode": {
          "type": ["string", "null"],
          "enum": [
            "CURRICULUM_ROOT",
            "FIELD",
            "GRADE",
            "SUBJECT",
            "CHAPTER",
            "TOPIC",
            "CONCEPT",
            "SUBCONCEPT",
            null
          ]
        },
        "parentSourceRecordKey": {
          "oneOf": [
            { "$ref": "#/$defs/sourceRecordKey" },
            { "type": "null" }
          ]
        },
        "structuralHints": {},
        "ambiguityMarkers": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}

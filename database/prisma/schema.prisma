generator client {
  provider            = "prisma-client"
  output              = "../../apps/api/src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  COUNSELOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AuthSession[]
  studentProfile StudentProfile?
  counselorProfile CounselorProfile?
  studentRelationships StudentCounselor[] @relation("StudentCounselorStudent")
  counselorRelationships StudentCounselor[] @relation("StudentCounselorCounselor")

  @@map("users")
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  familyId  String @db.Uuid

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

enum StudentCounselorStatus {
  ACTIVE
  INACTIVE
}

model StudentProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  educationLevel String?
  schoolName     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model CounselorProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  bio            String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("counselor_profiles")
}

model StudentCounselor {
  id          String                 @id @default(uuid()) @db.Uuid
  studentId   String                 @db.Uuid
  counselorId String                 @db.Uuid
  status      StudentCounselorStatus @default(ACTIVE)
  startedAt   DateTime               @default(now())
  endedAt     DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  student   User @relation("StudentCounselorStudent", fields: [studentId], references: [id], onDelete: Cascade)
  counselor User @relation("StudentCounselorCounselor", fields: [counselorId], references: [id], onDelete: Cascade)

  @@unique([studentId, counselorId])
  @@index([studentId])
  @@index([counselorId])
  @@index([status])
  @@map("student_counselor_relationships")
}

generator client {
  provider            = "prisma-client"
  output              = "../../apps/api/src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  COUNSELOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                         AuthSession[]
  studentProfile                   StudentProfile?
  counselorProfile                 CounselorProfile?
  studentRelationships             StudentCounselor[]           @relation("StudentCounselorStudent")
  counselorRelationships           StudentCounselor[]           @relation("StudentCounselorCounselor")
  createdDailyTasks                DailyTask[]                  @relation("DailyTaskCreator")
  curriculumVersionsCreated        CurriculumVersion[]          @relation("CurriculumVersionCreator")
  curriculumVersionsPublished      CurriculumVersion[]          @relation("CurriculumVersionPublisher")
  curriculumNodesCreated           CurriculumNode[]             @relation("CurriculumNodeCreator")
  curriculumRelationshipsCreated   CurriculumNodeRelationship[] @relation("CurriculumRelationshipCreator")
  curriculumRelationshipsApproved  CurriculumNodeRelationship[] @relation("CurriculumRelationshipApprover")
  curriculumImports                CurriculumImport[]           @relation("CurriculumImporter")
  curriculumIssuesResolved         CurriculumImportIssue[]      @relation("CurriculumIssueResolver")
  curriculumValidations            CurriculumValidationRun[]    @relation("CurriculumValidationInitiator")
  curriculumReviews                CurriculumReviewDecision[]   @relation("CurriculumReviewer")
  curriculumAuditEvents            CurriculumAuditLog[]         @relation("CurriculumAuditActor")
  curriculumMappingsCreated        CurriculumNodeMapping[]      @relation("CurriculumMappingCreator")
  curriculumMappingsApproved       CurriculumNodeMapping[]      @relation("CurriculumMappingApprover")
  legacyCurriculumMappingsCreated  LegacyCurriculumMapping[]    @relation("LegacyMappingCreator")
  legacyCurriculumMappingsReviewed LegacyCurriculumMapping[]    @relation("LegacyMappingReviewer")
  curriculumCapabilities           CurriculumCapabilityGrant[]  @relation("CurriculumCapabilityGrantee")
  curriculumCapabilitiesGranted    CurriculumCapabilityGrant[]  @relation("CurriculumCapabilityGrantor")
  curriculumCapabilitiesRevoked    CurriculumCapabilityGrant[]  @relation("CurriculumCapabilityRevoker")

  @@map("users")
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  familyId  String @db.Uuid

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

enum StudentCounselorStatus {
  ACTIVE
  INACTIVE
}

model StudentProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  educationLevel String?
  schoolName     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studySubjects      StudySubject[]
  studyPlans         StudyPlan[]
  dailyTasks         DailyTask[]
  studySessions      StudySession[]
  assessmentAttempts AssessmentAttempt[]
  goals              StudentGoal[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model CounselorProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  bio            String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("counselor_profiles")
}

model StudentCounselor {
  id          String                 @id @default(uuid()) @db.Uuid
  studentId   String                 @db.Uuid
  counselorId String                 @db.Uuid
  status      StudentCounselorStatus @default(ACTIVE)
  startedAt   DateTime               @default(now())
  endedAt     DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  student   User @relation("StudentCounselorStudent", fields: [studentId], references: [id], onDelete: Cascade)
  counselor User @relation("StudentCounselorCounselor", fields: [counselorId], references: [id], onDelete: Cascade)

  @@unique([studentId, counselorId])
  @@index([studentId])
  @@index([counselorId])
  @@index([status])
  @@map("student_counselor_relationships")
}

enum StudyPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum DailyTaskStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum DailyTaskSource {
  PERSONAL
  COUNSELOR
}

enum DailyTaskSkipReason {
  NO_TIME
  TOO_DIFFICULT
  FORGOT
  OTHER
}

model StudySubject {
  id               String    @id @default(uuid()) @db.Uuid
  studentProfileId String    @db.Uuid
  name             String
  normalizedName   String
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile           StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  dailyTasks               DailyTask[]
  studySessions            StudySession[]
  assessmentAttempts       AssessmentAttempt[]
  goals                    StudentGoal[]
  topics                   Topic[]
  legacyCurriculumMappings LegacyCurriculumMapping[]

  @@unique([studentProfileId, normalizedName])
  @@index([studentProfileId, archivedAt])
  @@map("study_subjects")
}

model Topic {
  id              String    @id @default(uuid()) @db.Uuid
  subjectId       String    @db.Uuid
  title           String
  normalizedTitle String
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subject                  StudySubject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dailyTasks               DailyTask[]
  assessmentAttempts       AssessmentAttempt[]
  legacyCurriculumMappings LegacyCurriculumMapping[]

  @@unique([subjectId, normalizedTitle])
  @@index([subjectId])
  @@map("study_topics")
}

model StudyPlan {
  id               String          @id @default(uuid()) @db.Uuid
  studentProfileId String          @db.Uuid
  title            String
  description      String?
  status           StudyPlanStatus @default(DRAFT)
  startsOn         DateTime        @db.Date
  endsOn           DateTime?       @db.Date
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  dailyTasks     DailyTask[]

  @@index([studentProfileId, status])
  @@index([studentProfileId, startsOn, endsOn])
  @@map("study_plans")
}

model DailyTask {
  id               String               @id @default(uuid()) @db.Uuid
  studentProfileId String               @db.Uuid
  createdByUserId  String               @db.Uuid
  source           DailyTaskSource
  studyPlanId      String?              @db.Uuid
  subjectId        String?              @db.Uuid
  topicId          String?              @db.Uuid
  title            String
  description      String?
  scheduledFor     DateTime             @db.Date
  estimatedMinutes Int?
  plannedTestCount Int                  @default(0)
  status           DailyTaskStatus      @default(PENDING)
  completedAt      DateTime?
  skipReason       DailyTaskSkipReason?
  skippedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  studentProfile     StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("DailyTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  studyPlan          StudyPlan?          @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)
  subject            StudySubject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic              Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  studySessions      StudySession[]
  assessmentAttempts AssessmentAttempt[]

  @@index([studentProfileId, scheduledFor])
  @@index([studentProfileId, status, scheduledFor])
  @@index([createdByUserId])
  @@index([studyPlanId])
  @@index([subjectId])
  @@index([topicId])
  @@map("daily_tasks")
}

model StudySession {
  id                 String    @id @default(uuid()) @db.Uuid
  studentProfileId   String    @db.Uuid
  subjectId          String?   @db.Uuid
  dailyTaskId        String?   @db.Uuid
  startedAt          DateTime
  endedAt            DateTime?
  cancelledAt        DateTime?
  focusRating        Int?
  studyQualityRating Int?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject        StudySubject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  dailyTask      DailyTask?     @relation(fields: [dailyTaskId], references: [id], onDelete: SetNull)

  @@index([studentProfileId, startedAt])
  @@index([studentProfileId, subjectId, startedAt])
  @@index([dailyTaskId])
  @@map("study_sessions")
}

model AssessmentAttempt {
  id               String    @id @default(uuid()) @db.Uuid
  studentProfileId String    @db.Uuid
  dailyTaskId      String?   @db.Uuid
  subjectId        String?   @db.Uuid
  topicId          String?   @db.Uuid
  title            String
  startedAt        DateTime
  endedAt          DateTime
  correctCount     Int
  incorrectCount   Int
  blankCount       Int
  invalidatedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  dailyTask      DailyTask?     @relation(fields: [dailyTaskId], references: [id], onDelete: SetNull)
  subject        StudySubject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic          Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([studentProfileId, endedAt])
  @@index([dailyTaskId])
  @@index([subjectId, endedAt])
  @@index([topicId, endedAt])
  @@map("assessment_attempts")
}

enum StudentGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model StudentGoal {
  id               String            @id @default(uuid()) @db.Uuid
  studentProfileId String            @db.Uuid
  subjectId        String?           @db.Uuid
  title            String
  description      String?
  targetDate       DateTime?         @db.Date
  status           StudentGoalStatus @default(ACTIVE)
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject        StudySubject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([studentProfileId, status])
  @@index([studentProfileId, targetDate])
  @@index([subjectId])
  @@map("student_goals")
}

enum CurriculumVersionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SUPERSEDED
}

enum CurriculumNodeAvailability {
  ACTIVE
  DEPRECATED
  RETIRED
}

enum CurriculumRelationshipType {
  PREREQUISITE
  APPLICABILITY
  EQUIVALENCE
  PREDECESSOR
  SUCCESSOR
  SPLIT
  MERGE
  REPLACEMENT
}

enum CurriculumRelationshipStatus {
  PROPOSED
  APPROVED
  SUPERSEDED
}

enum CurriculumImportStatus {
  CREATED
  VALIDATING
  COMPLETED
  FAILED
}

enum CurriculumSourceDisposition {
  PENDING
  ACCEPTED
  UNCHANGED
  AMBIGUOUS
  REJECTED
  EXCLUDED
}

enum CurriculumIssueSeverity {
  INFO
  WARNING
  ERROR
}

enum CurriculumIssueDisposition {
  OPEN
  RESOLVED
  EXCLUDED
  MORE_EVIDENCE_REQUIRED
}

enum CurriculumValidationStatus {
  RUNNING
  PASSED
  FAILED
}

enum CurriculumReviewOutcome {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum CurriculumMappingType {
  SAME_IDENTITY
  REPLACED_BY
  SPLIT_INTO
  MERGED_INTO
  EQUIVALENT_TO
}

enum CurriculumMappingStatus {
  PROPOSED
  APPROVED
  SUPERSEDED
}

enum LegacyCurriculumKind {
  STUDY_SUBJECT
  TOPIC
}

enum LegacyCurriculumDecision {
  PROPOSED
  CONFIRMED
  AMBIGUOUS
  LEGACY_ONLY
}

enum CurriculumCapability {
  CURRICULUM_DRAFT_READ
  CURRICULUM_DRAFT_EDIT
  CURRICULUM_IMPORT_OPERATE
  CURRICULUM_SOURCE_READ
  CURRICULUM_ISSUE_RESOLVE
  CURRICULUM_REVIEW_DECIDE
  CURRICULUM_PUBLISH
  CURRICULUM_MAPPING_APPROVE
  CURRICULUM_AUDIT_READ
  CURRICULUM_PERMISSION_MANAGE
}

enum CurriculumCapabilityScope {
  GLOBAL
}

enum CurriculumAuditOutcome {
  SUCCEEDED
  REJECTED
  FAILED
}

model CurriculumVersion {
  id               String                  @id @default(uuid()) @db.Uuid
  versionLabel     String                  @unique
  status           CurriculumVersionStatus @default(DRAFT)
  basedOnVersionId String?                 @db.Uuid
  effectiveFrom    DateTime?
  sourceSummary    String?
  revision         Int                     @default(0)
  createdById      String                  @db.Uuid
  reviewedAt       DateTime?
  publishedById    String?                 @db.Uuid
  publishedAt      DateTime?
  supersededAt     DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  basedOnVersion        CurriculumVersion?           @relation("CurriculumVersionBase", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions       CurriculumVersion[]          @relation("CurriculumVersionBase")
  createdBy             User                         @relation("CurriculumVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy           User?                        @relation("CurriculumVersionPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  nodeRevisions         CurriculumNodeRevision[]
  governedRelationships CurriculumNodeRelationship[] @relation("CurriculumRelationshipVersion")
  relationshipSources   CurriculumNodeRelationship[] @relation("CurriculumRelationshipSourceVersion")
  relationshipTargets   CurriculumNodeRelationship[] @relation("CurriculumRelationshipTargetVersion")
  imports               CurriculumImport[]
  validationRuns        CurriculumValidationRun[]
  reviewDecisions       CurriculumReviewDecision[]
  auditLogs             CurriculumAuditLog[]
  mappingSources        CurriculumNodeMapping[]      @relation("CurriculumMappingSourceVersion")
  mappingTargets        CurriculumNodeMapping[]      @relation("CurriculumMappingTargetVersion")
  legacyMappings        LegacyCurriculumMapping[]
  matchedSourceRecords  CurriculumSourceRecord[]     @relation("CurriculumSourceRecordMatchVersion")

  @@index([status])
  @@index([basedOnVersionId])
  @@map("curriculum_versions")
}

model CurriculumNodeType {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  displayName        String
  displayNameFa      String?
  isActive           Boolean  @default(true)
  allowedParentCodes Json?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  nodeRevisions CurriculumNodeRevision[]

  @@map("curriculum_node_types")
}

model CurriculumNode {
  id           String    @id @default(uuid()) @db.Uuid
  identityNote String?
  tombstonedAt DateTime?
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy            User                     @relation("CurriculumNodeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revisions            CurriculumNodeRevision[]
  matchedSourceRecords CurriculumSourceRecord[] @relation("CurriculumSourceRecordMatchNode")

  @@index([createdById])
  @@map("curriculum_nodes")
}

model CurriculumNodeRevision {
  curriculumVersionId String                     @db.Uuid
  curriculumNodeId    String                     @db.Uuid
  nodeTypeId          String                     @db.Uuid
  parentNodeId        String?                    @db.Uuid
  displayName         String
  sourceDisplayName   String
  searchName          String
  siblingPosition     Int
  sourceOrder         Int?
  availabilityStatus  CurriculumNodeAvailability @default(ACTIVE)
  deprecationReason   String?
  provenance          Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  version              CurriculumVersion            @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict, map: "curriculum_node_revisions_version_fkey")
  node                 CurriculumNode               @relation(fields: [curriculumNodeId], references: [id], onDelete: Restrict, map: "curriculum_node_revisions_node_fkey")
  nodeType             CurriculumNodeType           @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict, map: "curriculum_node_revisions_type_fkey")
  parent               CurriculumNodeRevision?      @relation("CurriculumNodeParent", fields: [curriculumVersionId, parentNodeId], references: [curriculumVersionId, curriculumNodeId], onDelete: Restrict, map: "curriculum_node_revisions_parent_fkey")
  children             CurriculumNodeRevision[]     @relation("CurriculumNodeParent")
  sourceRelationships  CurriculumNodeRelationship[] @relation("CurriculumRelationshipSource")
  targetRelationships  CurriculumNodeRelationship[] @relation("CurriculumRelationshipTarget")
  sourceMappings       CurriculumNodeMapping[]      @relation("CurriculumMappingSource")
  targetMappings       CurriculumNodeMapping[]      @relation("CurriculumMappingTarget")
  legacyMappings       LegacyCurriculumMapping[]
  matchedSourceRecords CurriculumSourceRecord[]     @relation("CurriculumSourceRecordMatch")

  @@id([curriculumVersionId, curriculumNodeId])
  @@unique([curriculumVersionId, parentNodeId, siblingPosition], map: "curriculum_node_revisions_parent_position_key")
  @@index([curriculumVersionId, nodeTypeId], map: "curriculum_node_revisions_type_idx")
  @@index([curriculumVersionId, searchName], map: "curriculum_node_revisions_search_idx")
  @@map("curriculum_node_revisions")
}

model CurriculumNodeRelationship {
  id                  String                       @id @default(uuid()) @db.Uuid
  curriculumVersionId String                       @db.Uuid
  sourceVersionId     String                       @db.Uuid
  sourceNodeId        String                       @db.Uuid
  targetVersionId     String                       @db.Uuid
  targetNodeId        String                       @db.Uuid
  type                CurriculumRelationshipType
  status              CurriculumRelationshipStatus @default(PROPOSED)
  rationale           String
  createdById         String                       @db.Uuid
  approvedById        String?                      @db.Uuid
  approvedAt          DateTime?
  supersededById      String?                      @db.Uuid
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  curriculumVersion CurriculumVersion            @relation("CurriculumRelationshipVersion", fields: [curriculumVersionId], references: [id], onDelete: Restrict, map: "curriculum_relationships_version_fkey")
  sourceVersion     CurriculumVersion            @relation("CurriculumRelationshipSourceVersion", fields: [sourceVersionId], references: [id], onDelete: Restrict, map: "curriculum_relationships_source_version_fkey")
  targetVersion     CurriculumVersion            @relation("CurriculumRelationshipTargetVersion", fields: [targetVersionId], references: [id], onDelete: Restrict, map: "curriculum_relationships_target_version_fkey")
  source            CurriculumNodeRevision       @relation("CurriculumRelationshipSource", fields: [sourceVersionId, sourceNodeId], references: [curriculumVersionId, curriculumNodeId], onDelete: Restrict, map: "curriculum_relationships_source_fkey")
  target            CurriculumNodeRevision       @relation("CurriculumRelationshipTarget", fields: [targetVersionId, targetNodeId], references: [curriculumVersionId, curriculumNodeId], onDelete: Restrict, map: "curriculum_relationships_target_fkey")
  createdBy         User                         @relation("CurriculumRelationshipCreator", fields: [createdById], references: [id], onDelete: Restrict, map: "curriculum_relationships_createdById_fkey")
  approvedBy        User?                        @relation("CurriculumRelationshipApprover", fields: [approvedById], references: [id], onDelete: Restrict, map: "curriculum_relationships_approvedById_fkey")
  supersededBy      CurriculumNodeRelationship?  @relation("CurriculumRelationshipSupersession", fields: [supersededById], references: [id], onDelete: Restrict, map: "curriculum_relationships_supersededById_fkey")
  supersedes        CurriculumNodeRelationship[] @relation("CurriculumRelationshipSupersession")

  @@unique([curriculumVersionId, sourceVersionId, sourceNodeId, targetVersionId, targetNodeId, type], map: "curriculum_node_relationships_endpoint_key")
  @@index([sourceVersionId, sourceNodeId], map: "curriculum_node_relationships_source_idx")
  @@index([targetVersionId, targetNodeId], map: "curriculum_node_relationships_target_idx")
  @@map("curriculum_node_relationships")
}

model CurriculumImport {
  id                    String                 @id @default(uuid()) @db.Uuid
  targetVersionId       String                 @db.Uuid
  manifestSchemaVersion String
  manifestChecksum      String
  sourceArtifactName    String
  sourceArtifactSha256  String
  transcriptionId       String
  transcriptionSha256   String
  idempotencyKey        String
  payloadChecksum       String
  status                CurriculumImportStatus @default(CREATED)
  acceptedCount         Int                    @default(0)
  unchangedCount        Int                    @default(0)
  ambiguousCount        Int                    @default(0)
  rejectedCount         Int                    @default(0)
  excludedCount         Int                    @default(0)
  report                Json?
  failureCode           String?
  importedById          String                 @db.Uuid
  retryOfImportId       String?                @db.Uuid
  startedAt             DateTime               @default(now())
  completedAt           DateTime?
  failedAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  targetVersion CurriculumVersion        @relation(fields: [targetVersionId], references: [id], onDelete: Restrict)
  importedBy    User                     @relation("CurriculumImporter", fields: [importedById], references: [id], onDelete: Restrict)
  retryOfImport CurriculumImport?        @relation("CurriculumImportRetry", fields: [retryOfImportId], references: [id], onDelete: Restrict)
  retries       CurriculumImport[]       @relation("CurriculumImportRetry")
  sourceRecords CurriculumSourceRecord[]
  issues        CurriculumImportIssue[]
  auditLogs     CurriculumAuditLog[]

  @@unique([targetVersionId, idempotencyKey], map: "curriculum_imports_target_idempotency_key")
  @@index([targetVersionId, status], map: "curriculum_imports_target_status_idx")
  @@map("curriculum_imports")
}

model CurriculumSourceRecord {
  id                         String                      @id @default(uuid()) @db.Uuid
  importId                   String                      @db.Uuid
  sourceRecordKey            String
  rawText                    String
  displayLabel               String
  sourceLocator              String
  sourceOrder                Int
  proposedNodeTypeCode       String?
  parentSourceRecordKey      String?
  structuralHints            Json?
  ambiguityMarkers           Json?
  checksum                   String
  disposition                CurriculumSourceDisposition @default(PENDING)
  matchedCurriculumVersionId String?                     @db.Uuid
  matchedCurriculumNodeId    String?                     @db.Uuid
  createdAt                  DateTime                    @default(now())

  curriculumImport CurriculumImport        @relation(fields: [importId], references: [id], onDelete: Restrict)
  matchedVersion   CurriculumVersion?      @relation("CurriculumSourceRecordMatchVersion", fields: [matchedCurriculumVersionId], references: [id], onDelete: Restrict, map: "curriculum_source_records_match_version_fkey")
  matchedNode      CurriculumNode?         @relation("CurriculumSourceRecordMatchNode", fields: [matchedCurriculumNodeId], references: [id], onDelete: Restrict, map: "curriculum_source_records_match_node_fkey")
  matchedRevision  CurriculumNodeRevision? @relation("CurriculumSourceRecordMatch", fields: [matchedCurriculumVersionId, matchedCurriculumNodeId], references: [curriculumVersionId, curriculumNodeId], onDelete: Restrict, map: "curriculum_source_records_match_revision_fkey")
  issues           CurriculumImportIssue[]

  @@unique([importId, sourceRecordKey], map: "curriculum_source_records_import_key")
  @@unique([importId, sourceOrder], map: "curriculum_source_records_import_order_key")
  @@index([matchedCurriculumVersionId, matchedCurriculumNodeId], map: "curriculum_source_records_match_idx")
  @@map("curriculum_source_records")
}

model CurriculumImportIssue {
  id               String                     @id @default(uuid()) @db.Uuid
  importId         String                     @db.Uuid
  sourceRecordId   String?                    @db.Uuid
  code             String
  severity         CurriculumIssueSeverity
  details          Json
  isBlocking       Boolean                    @default(true)
  disposition      CurriculumIssueDisposition @default(OPEN)
  resolution       Json?
  resolutionReason String?
  resolvedById     String?                    @db.Uuid
  resolvedAt       DateTime?
  createdAt        DateTime                   @default(now())

  curriculumImport CurriculumImport        @relation(fields: [importId], references: [id], onDelete: Restrict)
  sourceRecord     CurriculumSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  resolvedBy       User?                   @relation("CurriculumIssueResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([importId, disposition, isBlocking], map: "curriculum_import_issues_queue_idx")
  @@index([sourceRecordId], map: "curriculum_import_issues_source_idx")
  @@map("curriculum_import_issues")
}

model CurriculumValidationRun {

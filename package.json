{
  "name": "konkourx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter api dev",
    "build": "pnpm --filter api build",
    "test": "pnpm --filter api test",
    "typecheck": "pnpm --filter api typecheck",
    "db:validate": "pnpm --filter api exec prisma validate --config ../../prisma.config.ts",
    "db:status": "pnpm --filter api exec prisma migrate status --config ../../prisma.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
